{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "backend"],
      "port": 5000
    },
    {
      "name": "netlify-build",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8767", "--directory", "frontend/dist-phone"],
      "port": 8767
    }
  ]
}
