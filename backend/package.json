{
  "name": "sqa-study-backend",
  "version": "1.0.0",
  "description": "REST API for the SQA study app (Node.js + Express + SQLite)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node ../database/migrate.js",
    "db:seed": "node ../database/seeds/seed.js",
    "db:reset": "node ../database/migrate.js --reset && node ../database/seeds/seed.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
